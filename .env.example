# Jira MCP Server Configuration
# This file shows the structure for ./.jira-mcp/config.json
# Use "cloud" for Atlassian Cloud and "datacenter"/"server" for self-hosted Jira

# Option 1: Store token directly in config (less secure)
{
  "baseUrl": "https://jira.custom.domain.com",
  "hosting": "cloud",
  "email": "your-email@domain.com",
  "token": "your-jira-api-token-here"
}

# Option 2: Read token from environment variable (recommended)
# First, set: export JIRA_API_TOKEN="your-jira-api-token-here"
{
  "baseUrl": "https://jira.custom.domain.com",
  "hosting": "cloud",
  "email": "your-email@domain.com",
  "tokenEnvVar": "JIRA_API_TOKEN"
}

# Option 3: Flexible - provide both (env var takes priority)
# If $JIRA_API_TOKEN is set, it will be used
# If not set, it falls back to the token field
{
  "baseUrl": "https://jira.custom.domain.com",
  "hosting": "cloud",
  "email": "your-email@domain.com",
  "token": "fallback-token-here",
  "tokenEnvVar": "JIRA_API_TOKEN"
}

# Option 4: Jira Data Center / Server
{
  "baseUrl": "https://jira.devops.medable.com",
  "hosting": "datacenter",
  "token": "your-jira-personal-access-token"
}
